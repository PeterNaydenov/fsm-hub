{
  "name": "@peter.naydenov/fsm-hub",
  "description": "FSM orchestration and state-managment tool",
  "version": "3.0.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/fsm-hub.umd.js",
  "types": "./dist/types/main.d.cts",
  "type": "module",
  "files": [
    "dist",
    "src",
    "skills",
    "Changelog.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/fsm-hub.esm.mjs"
      },
      "require": {
        "types": "./dist/types/main.d.cts",
        "default": "./dist/fsm-hub.cjs"
      },
      "default": {
        "types": "./dist/types/main.d.cts",
        "default": "./dist/fsm-hub.umd.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build:types": "tsc -p tsconfig.json && node scripts/build-cts-types.js",
    "test:types": "npm run build:types && tsc -p test/types/tsconfig.json",
    "build": "npm run build:types && rollup -c",
    "prepublishOnly": "npm test && npm run test:types && rollup -c"
  },
  "dependencies": {
    "@peter.naydenov/stack": "^3.0.2",
    "ask-for-promise": "^3.2.1"
  },
  "devDependencies": {
    "@peter.naydenov/fsm": "6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "rollup": "^4.64.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/fsm-hub.git"
  },
  "keywords": [
    "fsm",
    "state-managment",
    "orchestration"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
